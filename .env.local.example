# Resend — powers the real contact/hire-me email delivery (src/app/actions.ts)
RESEND_API_KEY=

# Vercel AI Gateway — fallback for the "Ask my Butler" chat widget
# (src/app/api/butler/route.ts) when the real Butler backend below isn't configured.
# Create a key at https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Butler backend — the real "Ask my Butler" brain (full context on Anas +
# guarded disclosure policy + Slottr scheduling awareness). Server-side only,
# never exposed to the browser. Leave unset to use the AI Gateway fallback above.
BUTLER_API_BASE_URL=
BUTLER_PORTFOLIO_API_KEY=

# Slottr REST API (apps/api/v2 from the slottr repo, deployed separately from
# the main web app — see slottr/README.md for deploy notes). Powers the custom
# calendar UI in src/components/sections/Booking.tsx via src/lib/slottr.ts and
# the /api/booking/* routes. Server-side only, never exposed to the browser.
SLOTTR_API_BASE_URL=https://slottr-api.anasmasama.dev
SLOTTR_API_KEY=
SLOTTR_USERNAME=anasmasama
SLOTTR_EVENT_SLUG=main
