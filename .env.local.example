# Resend — powers the real contact/hire-me email delivery (src/app/actions.ts)
RESEND_API_KEY=

# Vercel AI Gateway — fallback for the "Ask my Butler" chat widget
# (src/app/api/butler/route.ts) when the real Butler backend below isn't configured.
# Create a key at https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Butler backend — the real "Ask my Butler" brain (full context on Anas +
# guarded disclosure policy + Slottr scheduling awareness). Server-side only,
# never exposed to the browser. Leave unset to use the AI Gateway fallback above.
BUTLER_API_BASE_URL=
BUTLER_PORTFOLIO_API_KEY=

# Slottr (cal.diy) — live scheduling widget (src/components/sections/SlottrBookingWidget.tsx),
# deployed at slottr.anasmasama.dev under the "anasmasama" account, synced to
# Google Calendar for real availability. The widget renders nothing until
# NEXT_PUBLIC_SLOTTR_WEBAPP_URL points at a real (non-localhost) deployment.
# NEXT_PUBLIC_SLOTTR_API_KEY is a placeholder for future authenticated/branding
# use — the public inline embed itself needs no key, only the webapp URL + event slug.
NEXT_PUBLIC_SLOTTR_API_KEY=placeholder-until-needed
NEXT_PUBLIC_SLOTTR_WEBAPP_URL=https://slottr.anasmasama.dev
NEXT_PUBLIC_SLOTTR_EVENT_SLUG=anasmasama/30min
